{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestre-yoda.dev/schemas/golden-path-report.v1.schema.json",
  "title": "Mestre Yoda Compliance Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "profile",
    "compliant",
    "score",
    "summary",
    "rules"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "profile": { "$ref": "#/$defs/profile" },
    "compliant": { "type": "boolean" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "blocking", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocking": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "description",
          "passed",
          "signal",
          "expected",
          "observed",
          "remediation"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": {
            "enum": ["blocking", "required", "recommended"]
          },
          "description": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "signal": { "type": "string", "minLength": 1 },
          "expected": { "type": "boolean" },
          "observed": { "type": "boolean" },
          "remediation": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
