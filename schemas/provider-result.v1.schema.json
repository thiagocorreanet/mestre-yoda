{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestre-yoda.dev/schemas/provider-result.v1.schema.json",
  "title": "Mestre Yoda Provider Result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "provider",
        "providerVersion",
        "command",
        "status",
        "result"
      ],
      "properties": {
        "protocolVersion": { "const": "1.0.0" },
        "provider": { "const": "mestre-yoda" },
        "providerVersion": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "status": { "const": "success" },
        "result": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "provider",
        "providerVersion",
        "command",
        "status",
        "error"
      ],
      "properties": {
        "protocolVersion": { "const": "1.0.0" },
        "provider": { "const": "mestre-yoda" },
        "providerVersion": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "status": { "const": "failure" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "summary"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  ]
}
